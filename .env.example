# Copy this file to .env (git ignores .env) and fill it in. Never commit the real topic.

# ntfy topic for the phone and watch notifications (same name as in the ntfy app)
IBUKI_NTFY_TOPIC=
# IBUKI_NTFY_URL=https://ntfy.sh
# Access token (tk_...) for a protected topic, so the topic name is no longer the only secret:
# an ntfy.sh account with a reserved topic, or your own ntfy server. Never commit it.
# IBUKI_NTFY_TOKEN=

# Seconds without breathing before the alert: 10 for the demo, 20 for babies
# IBUKI_NO_BREATH_S=10

# The laptop siren for no breathing (stops with the dashboard's stop button, the board's SW1, or Enter)
# IBUKI_SIREN=0   turns it off
